# Local development backend (The Game Pensieve API).
# Base URL including the /v1 prefix; endpoints are then e.g. `${API_BASE_URL}/toys`.
# The available routes are documented by the backend repository's OpenAPI spec.
#
# PRODUCTION: this value must be overridden with the deployed API URL
# (via .env.production or the host's environment). The app throws at runtime
# if API_BASE_URL is unset outside of development — see src/lib/api.ts.
API_BASE_URL=http://localhost:8080/v1

# Password used to encrypt the httpOnly BFF session cookie (iron-session). Must
# be at least 32 characters. This committed value is a DEV-ONLY default so the
# app and E2E tests run out of the box.
# PRODUCTION: override with a real secret via .env.production or the host's
# environment — never ship this default.
SESSION_SECRET=dev-only-insecure-session-secret-change-me-in-prod

# Keycloak OIDC (dev defaults — the BFF is a confidential client named
# `pensieve-web`). OIDC_ISSUER is browser-facing; OIDC_INTERNAL_ISSUER stays
# unset in host dev (same host as OIDC_ISSUER) and is only set in compose.
OIDC_ISSUER=http://localhost:8081/realms/pensieve
OIDC_CLIENT_ID=pensieve-web
OIDC_CLIENT_SECRET=dev-web-secret-change-me
