# Reference for the environment variables this project expects.
# Non-secret defaults live in .env.development (committed).
# Secrets (e.g. an API token) belong in .env.local, which is gitignored.

# Base URL of the Game Pensieve backend API, including the /v1 prefix.
API_BASE_URL=http://localhost:8080/v1

# The API documents Bearer auth. Interactive
# users authenticate via the BFF session (login), but a static fallback token can
# be supplied here for non-interactive/server deployments (never commit it):
# API_TOKEN=your-token-here

# Password used to encrypt the httpOnly BFF session cookie (iron-session). Must
# be at least 32 characters. A dev-only default lives in .env.development; in
# production set a strong, unique secret here (or in the host environment):
# SESSION_SECRET=a-long-random-string-of-at-least-32-characters

# Keycloak OIDC (the BFF is a confidential OIDC client). OIDC_ISSUER is
# BROWSER-facing (authorization redirect + id_token `iss` validation).
# OIDC_INTERNAL_ISSUER is SERVER-facing (token exchange + refresh); in compose the
# BFF container reaches Keycloak at http://keycloak:8080 while tokens still carry
# the canonical localhost:8081 issuer. In host dev they're the same — leave
# OIDC_INTERNAL_ISSUER unset to default to OIDC_ISSUER.
OIDC_ISSUER=http://localhost:8081/realms/pensieve
# OIDC_INTERNAL_ISSUER=http://keycloak:8080/realms/pensieve   # set only in compose
OIDC_CLIENT_ID=pensieve-web
# The confidential client secret — never commit a real one (override in .env.local
# or the host environment for anything but local dev).
OIDC_CLIENT_SECRET=dev-web-secret-change-me
